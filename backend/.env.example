# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/doctor-appointment-system

# Server Port
PORT=5000

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# ============ Google Maps API ============
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============ Mapbox (Alternative to Google Maps) ============
MAPBOX_API_KEY=your_mapbox_api_key_here

# ============ Jitsi Meet Configuration ============
# For production, you may need to configure Jitsi JWT signing
JITSI_API_KEY=your_jitsi_api_key_here
JITSI_API_SECRET=your_jitsi_api_secret_here

# ============ Twilio Configuration (Alternative Video) ============
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here

# ============ AI/Chatbot Services ============
GEMINI_API_KEY=your_gemini_api_key_here

# ============ Email Service (for notifications) ============
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ============ AWS S3 (for recording storage) ============
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_BUCKET_NAME=doctor-appointment-recordings
